rules_version = '2';

// CF Academy — Firestore security rules
// Firebase console → Firestore Database → Rules → paste → Publish.
// Put the 2 OWNER emails below (same as OWNER_EMAILS in js/firebase-config.js).
// Staff logins created in Admin → Staff Config are stored in /staff/{uid}.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          'cfacademyadmin@gmail.com',
          'owner2@example.com'    // TODO: owner 2 login email (lower case)
        ];
    }
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isActiveStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.active == true;
    }
    // Owners + staff with role "Admin": everything, incl. deletes and staff logins
    function isAdmin() {
      return isOwner() || (isActiveStaff() && staffDoc().data.role == 'Admin');
    }
    // Anyone on the team (owners, admins, staff)
    function isTeam() {
      return isOwner() || isActiveStaff();
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Parents (not logged in) may only CREATE a booking — never read or change one.
    match /bookings/{id} {
      allow create: if request.resource.data.keys().hasOnly([
             'bookingNo', 'mode', 'studentName', 'studentClass', 'board', 'subjects',
             'area', 'city', 'address', 'days', 'time', 'startDate',
             'parentName', 'phone', 'email', 'notes', 'status', 'createdAt', 'source'])
        && str(request.resource.data.parentName, 2, 80)
        && str(request.resource.data.studentName, 1, 80)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && str(request.resource.data.subjects, 1, 300)
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt is number;
      allow create, read, update: if isTeam();
      allow delete: if isAdmin();
    }

    match /tutors/{id} {
      allow read, create, update: if isTeam();
      allow delete: if isAdmin();
    }
    match /students/{id} {
      allow read, create, update: if isTeam();
      allow delete: if isAdmin();
    }
    match /payments/{id} {
      allow read, create: if isTeam();
      allow update, delete: if isAdmin();
    }
    // tutor salary payouts (Tutors → ₹ Finance)
    match /tutorPayouts/{id} {
      allow read, create, update: if isTeam();
      allow delete: if isAdmin();
    }
    // receipt number counter
    match /meta/{id} {
      allow read, write: if isTeam();
    }
    // home page ad banners: anyone can view, only admins change them
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // "Meet our tutors" cards on the website: anyone can view, only admins change them
    match /featuredTutors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Parent reviews: anyone can WRITE one (always starts unapproved);
    // the public can read only approved reviews; the team approves / hides.
    match /reviews/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'place', 'rating', 'text', 'approved', 'createdAt'])
        && str(request.resource.data.name, 2, 60)
        && (!('place' in request.resource.data) || str(request.resource.data.place, 0, 60))
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && str(request.resource.data.text, 10, 600)
        && request.resource.data.approved == false
        && request.resource.data.createdAt is int;
      allow read: if resource.data.approved == true || isTeam();
      allow update: if isTeam();
      allow delete: if isAdmin();
    }
    // staff logins: each person can read their own record; only admins manage them
    match /staff/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
